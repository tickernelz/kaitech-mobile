{
  "expo": {
    "name": "Kaitech",
    "slug": "kaitech-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9FC",
    "primaryColor": "#441D65",
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./src/i18n/native/en.json",
      "id": "./src/i18n/native/id.json"
    },
    "ios": {
      "bundleIdentifier": "io.kaitech.mobile",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "io.kaitech.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#441D65",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "id"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kaitech uses Face ID to unlock the app when app lock is on."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FAF9FC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#110B18"
          },
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans_700Bold.ttf",
            "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Plus Jakarta Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
