{
  "expo": {
    "name": "Kaitech",
    "slug": "kaitech-mobile",
    "version": "0.2.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9FC",
    "primaryColor": "#441D65",
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./src/i18n/native/en.json",
      "id": "./src/i18n/native/id.json"
    },
    "ios": {
      "bundleIdentifier": "io.kaitech.mobile",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "io.kaitech.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#441D65",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "id"
          ]
        }
      ],
      "./plugins/with-livekit-gradle",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./modules/kaitech-call/plugin",
      "./plugins/with-broadcast-extension",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kaitech uses Face ID to unlock the app when app lock is on."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FAF9FC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#110B18"
          },
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans_700Bold.ttf",
            "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Plus Jakarta Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kaitech uses the microphone to record meetings and voice messages, and to make calls.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kaitech opens your photos so you can send them in messages.",
          "cameraPermission": "Kaitech uses the camera to take photos and videos you send in messages.",
          "microphonePermission": "Kaitech uses the microphone to record meetings and voice messages, and to make calls."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#441D65",
          "defaultChannel": "messages",
          "enableRemoteNotifications": false
        }
      ],
      "expo-background-task",
      "./plugins/meeting-recording.js"
    ]
  }
}
